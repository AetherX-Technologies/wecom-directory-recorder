# Desktop WeCom detail extraction: an authorized OpenAI-compatible image endpoint.
VL_MODEL_URL=https://vision.example.com/v1/chat/completions
VL_MODEL_NAME=Qwen3.6-35B-A3B
VL_MODEL_KEY=replace-with-your-api-key
VL_MODEL_TIMEOUT=180
VL_MODEL_MAX_RETRIES=2

# Optional legacy OCR/subtitle workflows; not needed for WeCom detail extraction.
OCR_MODEL_URL=https://ocr.example.com/v1/chat/completions
OCR_MODEL_NAME=PaddleOCR-VL-1.6
OCR_MODEL_KEY=replace-with-your-api-key
OCR_MODEL_TIMEOUT=120

# Optional legacy OCR text filtering, regular expressions. Empty = no filtering.
OCR_WATERMARK_PATTERN=
OCR_WATERMARK_DATE_PATTERN=
